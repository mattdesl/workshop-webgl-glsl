{
  "name": "re2js",
  "version": "2.9.1",
  "description": "RE2JS is the JavaScript port of RE2, a regular expression engine that provides linear time matching",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "re2js",
    "re2",
    "regex engine",
    "redos",
    "regex"
  ],
  "author": "Oleksii Vasyliev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/le0pard/re2js.git"
  },
  "bugs": {
    "url": "https://github.com/le0pard/re2js/issues"
  },
  "homepage": "https://github.com/le0pard/re2js#readme",
  "files": [
    "build/index.js",
    "build/index.cjs",
    "build/index.umd.js",
    "build/index.d.ts",
    "build/index.d.cts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "build/index.cjs",
  "module": "build/index.js",
  "unpkg": "build/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "types": "build/index.d.ts",
  "scripts": {
    "build": "rolldown -c && yarn build:types",
    "dev": "rolldown -c -w",
    "build:types": "tsc && dts-bundle-generator -o build/index.d.ts tmp/types/index.d.ts && cp build/index.d.ts build/index.d.cts && rm -rf tmp/types",
    "lint": "oxfmt --check src tools *.config.js && oxlint 'src/**/*.js' 'tools/**/*.{js,cjs,mjs}' rolldown.config.js vitest.config.js",
    "format": "oxfmt src tools *.config.js",
    "fuzz": "node tools/fuzz/fuzz.js",
    "gen:char-groups": "perl tools/scripts/make_perl_groups.pl > src/CharGroup.js && oxfmt src/CharGroup.js",
    "gen:unicode": "node tools/scripts/genUnicodeTable.js src/UnicodeTables.js && oxfmt src/UnicodeTables.js",
    "test": "vitest run --project=node",
    "test:watch": "vitest --project=node",
    "test:browser": "vitest run --browser.enabled --project=browser",
    "test:package": "node tools/build-check/smoke.mjs && node tools/build-check/smoke.cjs && node tools/build-check/umd.cjs && tsc -p tools/build-check/tsconfig.json && publint --strict && attw --pack . --profile node16",
    "coverage": "vitest run --project=node --coverage",
    "bench": "rolldown -c && vitest bench --run --project='node (bench)'"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@unicode/unicode-17.0.0": "^2.0.8",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dts-bundle-generator": "^9.5.1",
    "globals": "^17.13.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "rolldown": "1.2.14",
    "typescript": "^7.0.2",
    "unicode-property-value-aliases": "^4.0.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}